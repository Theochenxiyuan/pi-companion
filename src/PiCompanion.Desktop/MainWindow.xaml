<Window x:Class="PiCompanion.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Pi Companion — 智能体对话"
        Width="1240"
        Height="820"
        MinWidth="940"
        MinHeight="520"
        SizeToContent="Manual"
        WindowStartupLocation="CenterScreen"
        Closing="OnClosing"
        Loaded="OnLoaded"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid Background="{DynamicResource WindowBrush}" ClipToBounds="True">
        <wv2:WebView2 x:Name="ChatWebView"
                      MinHeight="0"
                      Visibility="Hidden"
                      AutomationProperties.Name="智能体对话"
                      AllowExternalDrop="True" />

        <Border x:Name="LoadingPanel"
                Background="{DynamicResource WindowBrush}"
                AutomationProperties.Name="{Binding ElementName=LoadingTitle, Path=Text}"
                AutomationProperties.LiveSetting="Polite">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="62" Height="62" HorizontalAlignment="Center">
                    <Border Width="54" Height="54" CornerRadius="18" Background="{DynamicResource RaisedBrush}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="π" FontFamily="{StaticResource TypographyFontBrand}" FontSize="{StaticResource TypographySizeBrandLarge}" Foreground="{DynamicResource AccentHoverBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Control x:Name="LoadingSpinner"
                             Width="18"
                             Height="18"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Bottom"
                             Style="{StaticResource LoadingSpinner}">
                        <Control.RenderTransform>
                            <RotateTransform x:Name="LoadingSpinnerRotate" CenterX="9" CenterY="9" />
                        </Control.RenderTransform>
                    </Control>
                </Grid>
                <TextBlock x:Name="LoadingTitle" Text="正在准备智能体对话" Margin="0,18,0,0"
                            FontSize="{StaticResource TypographySizeTitleSmall}" FontWeight="{StaticResource TypographyWeightSemibold}" HorizontalAlignment="Center" />
                <ScrollViewer MaxWidth="560"
                              MaxHeight="140"
                              Margin="0,7,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="LoadingDetail"
                               Text="启动 WebView2 并加载本地 Vue 应用"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"
                               FontSize="{StaticResource TypographySizeCaption}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" />
                </ScrollViewer>
                <StackPanel x:Name="LoadingErrorActions" Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,18,0,0" Visibility="Collapsed">
                    <Button x:Name="RetryButton"
                            Content="重试"
                            AutomationProperties.Name="{Binding RelativeSource={RelativeSource Self}, Path=Content}"
                            Click="OnRetryClick" />
                    <Button x:Name="CopyLoadingErrorButton" Content="复制错误信息" Margin="8,0,0,0"
                            AutomationProperties.Name="{Binding RelativeSource={RelativeSource Self}, Path=Content}"
                            Style="{StaticResource SecondaryButton}" Click="OnCopyLoadingErrorClick" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
