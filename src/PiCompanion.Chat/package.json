{
  "name": "@pi-companion/chat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run tokens:check && vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:acceptance": "vitest run",
    "tokens:generate": "node ../../scripts/generate-design-tokens.mjs",
    "tokens:check": "node ../../scripts/generate-design-tokens.mjs --check"
  },
  "dependencies": {
    "@he-tree/vue": "2.10.5",
    "dompurify": "3.4.17",
    "marked": "18.1.2",
    "pinia": "4.1.0",
    "reka-ui": "2.11.0",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "vue-tsc": "3.3.13"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.3"
  }
}
