<Window x:Class="PiCompanion.Desktop.Monitor.MonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pi Companion 任务监视器"
        Width="440"
        Height="88"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        MouseDoubleClick="OnMouseDoubleClick"
        Activated="OnActivated"
        Deactivated="OnDeactivated"
        PreviewMouseDown="OnPreviewMouseDown"
        PreviewMouseUp="OnPreviewMouseUp"
        Closing="OnClosing">
    <Window.Resources>
        <ContextMenu x:Key="MonitorContextMenu"
                     x:Shared="False"
                     MinWidth="168"
                     Padding="4"
                     Background="{DynamicResource SurfaceBrush}"
                     BorderBrush="{DynamicResource StrokeBrush}"
                     BorderThickness="1"
                     Opened="OnMonitorContextMenuOpened"
                     Closed="OnMonitorContextMenuClosed">
            <ContextMenu.Template>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.42" Color="{StaticResource ColorShadow}" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </ContextMenu.Template>
            <ContextMenu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Padding" Value="12,8" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Border x:Name="ItemBorder"
                                        Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="6">
                                    <TextBlock Text="{TemplateBinding Header}"
                                               Foreground="{TemplateBinding Foreground}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ContextMenu.Resources>
            <MenuItem Header="新建任务" Click="OnNewTaskClick" />
            <MenuItem Header="隐藏任务监视器" Click="OnHideClick" />
            <MenuItem Header="退出 Pi Companion"
                      Margin="0,3,0,0"
                      Foreground="{DynamicResource DangerBrush}"
                      Click="OnExitClick" />
        </ContextMenu>
        <SolidColorBrush x:Key="MonitorTitleHoverBrush"
                         Color="{DynamicResource ColorNeutral750}"
                         Opacity="0.5" />
        <Style x:Key="MonitorTitleSelectorButton" TargetType="Button">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="-6,-4,0,-4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="ToolTip" Value="滚动或点击切换任务" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TitleBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TitleBorder" Property="Background" Value="{DynamicResource MonitorTitleHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TitleBorder" Property="Opacity" Value="0.55" />
                                <Setter TargetName="TitleBorder" Property="Background" Value="Transparent" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MonitorIconButton"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="IconButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconButtonBorder" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="IconButtonBorder" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="IconButtonBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MonitorGrowingTextBox"
               TargetType="TextBox"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="MaxHeight" Value="112" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TextBoxBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="RootBorder"
                Margin="8"
                MouseEnter="OnMonitorMouseEnter"
                MouseLeave="OnMonitorMouseLeave"
                PreviewMouseDown="OnDragSurfaceMouseLeftButtonDown"
                ContextMenu="{StaticResource MonitorContextMenu}"
                ContextMenuOpening="OnMonitorContextMenuOpening"
                ContextMenuService.ShowOnDisabled="True"
                Background="{DynamicResource GlassWindowBrush}"
                BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="1"
                CornerRadius="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.42" Color="{StaticResource ColorShadow}" />
        </Border.Effect>
        <Grid x:Name="MonitorLayout" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="SharedHeader">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="30" Height="30" Margin="0,0,9,0" VerticalAlignment="Center">
                    <Ellipse x:Name="HeaderStatusHalo"
                             Fill="{DynamicResource AccentHaloBrush}"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="HeaderStatusHaloScale" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="HeaderStatusDot"
                             Width="10"
                             Height="10"
                             Fill="{DynamicResource AccentHoverBrush}"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="HeaderStatusDotScale" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button x:Name="HeaderTitleButton"
                            Style="{StaticResource MonitorTitleSelectorButton}"
                            AutomationProperties.Name="切换任务"
                            PreviewMouseLeftButtonDown="OnTaskSelectorMouseDown"
                            PreviewMouseWheel="OnTaskPickerMouseWheel"
                            PreviewKeyDown="OnTaskPickerKeyDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="HeaderTitle" Text="Pi Companion" FontSize="{StaticResource TypographySizeBody}" FontWeight="{StaticResource TypographyWeightSemibold}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="HeaderStatus" Text="准备就绪" Margin="0,3,0,0"
                                           FontSize="{StaticResource TypographySizeCaption}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <Grid x:Name="HeaderTaskScrollCue"
                                  Grid.Column="1"
                                  Width="14"
                                  Height="25"
                                  Margin="12,0,2,0"
                                  VerticalAlignment="Center"
                                  IsHitTestVisible="False">
                                <Path Data="M 2,5 L 7,1 L 12,5 M 2,20 L 7,24 L 12,20"
                                      Stroke="{DynamicResource TextMutedBrush}"
                                      StrokeThickness="1.35"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                                <Ellipse Width="4"
                                         Height="4"
                                         Fill="{DynamicResource TextMutedBrush}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Button>
                </StackPanel>
                <Button x:Name="HeaderExpandedToggleButton"
                        Grid.Column="2"
                        Style="{StaticResource MonitorIconButton}"
                        VerticalAlignment="Center"
                        ToolTip="展开"
                        AutomationProperties.Name="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}"
                        Click="OnExpandedToggleClick">
                    <Grid Width="15" Height="15">
                        <Path x:Name="HeaderExpandIcon"
                              Data="M 2,5 L 7.5,10.5 L 13,5"
                              Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                        <Path x:Name="HeaderCollapseIcon"
                              Data="M 2,10 L 7.5,4.5 L 13,10"
                              Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Visibility="Collapsed" />
                    </Grid>
                </Button>
            </Grid>

            <Grid x:Name="ExpandedBody"
                  Grid.Row="1"
                  Margin="0,16,0,0"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="0,0,0,12" Padding="12,10" Background="{DynamicResource RaisedBrush}"
                        BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="DirectoryText" Text="尚未选择工作目录" FontSize="{StaticResource TypographySizeCaption}"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock x:Name="ModelText" Grid.Row="1" Text="等待任务" Margin="0,5,0,0" FontSize="{StaticResource TypographySizeCaption}"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Border x:Name="ActivityPanel" Padding="12" Background="{DynamicResource GlassPanelBrush}" CornerRadius="10"
                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="ActivityPanelTitle" Text="正在执行" FontSize="{StaticResource TypographySizeBodySmall}" FontWeight="{StaticResource TypographyWeightSemibold}" />
                            <TextBlock x:Name="ActivityStatusText" Grid.Row="1" Margin="0,5,0,0" Text="等待任务"
                                       TextWrapping="Wrap" FontSize="{StaticResource TypographySizeCaption}" Foreground="{DynamicResource TextMutedBrush}" />
                            <ListBox x:Name="ActivityList" Grid.Row="2" Margin="0,10,0,0"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentHoverBrush}"
                                                     Margin="1,6,8,0" VerticalAlignment="Top" />
                                            <TextBlock Text="{Binding}"
                                                       ToolTip="{Binding}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="{StaticResource TypographySizeCaption}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border x:Name="InteractionPanel" Padding="14" Background="{DynamicResource WarningTintBrush}"
                            BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                            CornerRadius="10" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="InteractionTitle" Text="Agent 请求权限"
                                           VerticalAlignment="Center"
                                           FontWeight="{StaticResource TypographyWeightSemibold}"
                                           FontSize="{StaticResource TypographySizeBody}" />
                                <Button x:Name="CopyInteractionButton" Grid.Column="1"
                                        Content="复制详情" Style="{StaticResource GhostButton}"
                                        Focusable="False" Padding="6,3"
                                        Click="OnCopyInteractionClick" />
                            </Grid>
                            <ScrollViewer Grid.Row="1" MaxHeight="180" Margin="0,7,0,13"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="InteractionPrompt"
                                           Text="Pi Agent 正在等待你的响应。"
                                           TextWrapping="Wrap" FontSize="{StaticResource TypographySizeCaption}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </ScrollViewer>
                            <WrapPanel x:Name="ApprovalActions" Grid.Row="2" HorizontalAlignment="Right">
                                <Button Content="拒绝" Style="{StaticResource SecondaryButton}" Focusable="False"
                                        Padding="12,7" Margin="4,4,0,0" Click="OnRejectClick" />
                                <Button Content="本任务内允许同类操作" Style="{StaticResource SecondaryButton}"
                                        Focusable="False" Padding="12,7" Margin="4,4,0,0"
                                        Click="OnApproveTaskClick" />
                                <Button Content="允许一次" Focusable="False" Padding="12,7" Margin="4,4,0,0"
                                        Click="OnApproveClick" />
                            </WrapPanel>
                            <Grid x:Name="AnswerActions" Grid.Row="2" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="InteractionResponseTextBox"
                                         Style="{StaticResource MonitorGrowingTextBox}"
                                         PreviewKeyDown="OnMonitorInputPreviewKeyDown"
                                         FontSize="{StaticResource TypographySizeBodySmall}" />
                                <Button Grid.Column="2" Content="取消" Style="{StaticResource SecondaryButton}"
                                        Height="40" VerticalAlignment="Center"
                                        Focusable="False" Padding="12,8" Click="OnCancelInteractionClick" />
                                <Button Grid.Column="4" Content="回答" Height="40"
                                        Focusable="False" Padding="12,8"
                                        VerticalAlignment="Center"
                                        Click="OnAnswerClick" />
                            </Grid>
                            <StackPanel x:Name="QuestionSelectActions" Grid.Row="2" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="InteractionOptionsComboBox" Padding="8,6"
                                              FontSize="{StaticResource TypographySizeBodySmall}"
                                              SelectionChanged="OnInteractionOptionChanged" />
                                    <Button Grid.Column="2" Content="取消" Style="{StaticResource SecondaryButton}"
                                            Height="40" VerticalAlignment="Center"
                                            Focusable="False" Padding="12,8" Click="OnCancelInteractionClick" />
                                    <Button x:Name="SelectAnswerButton" Grid.Column="4" Content="选择"
                                            Height="40" VerticalAlignment="Center"
                                            Focusable="False" Padding="12,8" Click="OnSelectAnswerClick" />
                                </Grid>
                                <TextBox x:Name="InteractionCustomResponseTextBox" Margin="0,8,0,0"
                                         Style="{StaticResource MonitorGrowingTextBox}"
                                         PreviewKeyDown="OnMonitorInputPreviewKeyDown"
                                         FontSize="{StaticResource TypographySizeBodySmall}"
                                         Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="ResultPanel" MaxHeight="360" Padding="16" VerticalAlignment="Top"
                            Background="{DynamicResource GlassPanelBrush}" CornerRadius="12"
                            BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="ResultStatusDot"
                                         Width="8"
                                         Height="8"
                                         Fill="{DynamicResource SuccessBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock x:Name="ResultTitle" Grid.Column="1" Margin="9,0,0,0"
                                           Text="本轮任务已完成" FontSize="{StaticResource TypographySizeBody}" FontWeight="{StaticResource TypographyWeightSemibold}"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <ScrollViewer Grid.Row="1" Margin="0,14,0,0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <StackPanel x:Name="ResultActivityCounts" Orientation="Horizontal">
                                        <Border x:Name="ResultThinkingBadge" Padding="7,4" Background="{DynamicResource RaisedBrush}" CornerRadius="5">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="思考" FontSize="{StaticResource TypographySizeCaption}"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock x:Name="ResultThinkingCount" Margin="5,0,0,0"
                                                           FontSize="{StaticResource TypographySizeCaption}" FontWeight="{StaticResource TypographyWeightSemibold}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="ResultToolBadge" Margin="7,0,0,0" Padding="7,4" Background="{DynamicResource RaisedBrush}" CornerRadius="5">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="工具调用" FontSize="{StaticResource TypographySizeCaption}"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock x:Name="ResultToolCount" Margin="5,0,0,0"
                                                           FontSize="{StaticResource TypographySizeCaption}" FontWeight="{StaticResource TypographyWeightSemibold}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="ResultWebSearchBadge" Margin="7,0,0,0" Padding="7,4" Background="{DynamicResource RaisedBrush}" CornerRadius="5">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="网络搜索" FontSize="{StaticResource TypographySizeCaption}"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock x:Name="ResultWebSearchCount" Margin="5,0,0,0"
                                                           FontSize="{StaticResource TypographySizeCaption}" FontWeight="{StaticResource TypographyWeightSemibold}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel x:Name="ResultInteractionSection" Margin="0,13,0,0">
                                        <ItemsControl x:Name="ResultInteractionList"
                                                      HorizontalContentAlignment="Stretch">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Kind}" FontSize="{StaticResource TypographySizeCaption}"
                                                                   FontWeight="{StaticResource TypographyWeightSemibold}"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding Summary}"
                                                                   ToolTip="{Binding Summary}" TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   FontSize="{StaticResource TypographySizeCaption}"
                                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <Grid x:Name="ResultSummaryLoading"
                                          Margin="0,14,0,0"
                                          Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="16"
                                              Height="16"
                                              VerticalAlignment="Center">
                                            <Grid.RenderTransform>
                                                <RotateTransform x:Name="ResultSummarySpinnerRotate"
                                                                 CenterX="8"
                                                                 CenterY="8" />
                                            </Grid.RenderTransform>
                                            <Ellipse Stroke="{DynamicResource AccentBrush}"
                                                     StrokeThickness="2"
                                                     Opacity="0.18" />
                                            <Path Data="M 8,1 A 7,7 0 0 1 15,8"
                                                  Stroke="{DynamicResource AccentBrush}"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Fill="Transparent" />
                                        </Grid>
                                        <TextBlock Grid.Column="1"
                                                   Margin="8,0,0,0"
                                                   Text="正在生成 AI 总结"
                                                   VerticalAlignment="Center"
                                                   FontSize="{StaticResource TypographySizeBodySmall}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Grid>

                                    <TextBlock x:Name="ResultSummary" Margin="0,14,0,0" TextWrapping="Wrap"
                                               FontSize="{StaticResource TypographySizeBodySmall}" LineHeight="{StaticResource TypographyLineHeightBody}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border x:Name="IdlePanel" Padding="14" Background="{DynamicResource GlassPanelBrush}" CornerRadius="10"
                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="暂无进行中的任务" FontSize="{StaticResource TypographySizeBody}" FontWeight="{StaticResource TypographyWeightSemibold}" />
                            <TextBlock Text="从智能体对话新建任务，任务监视器会在这里显示最高优先级状态。"
                                       Margin="0,7,0,0" TextWrapping="Wrap" FontSize="{StaticResource TypographySizeCaption}"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="DirectionPanel" Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="DirectionTextBox"
                                 Style="{StaticResource MonitorGrowingTextBox}"
                                 FontSize="{StaticResource TypographySizeBodySmall}"
                                 PreviewKeyDown="OnMonitorInputPreviewKeyDown"
                                 TextChanged="OnDirectionTextChanged" />
                        <TextBlock x:Name="DirectionPlaceholderText" Margin="11,0,8,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                   Text="继续这项任务" FontSize="{StaticResource TypographySizeBodySmall}"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <Popup x:Name="SkillSuggestionPopup"
                               PlacementTarget="{Binding ElementName=DirectionTextBox}"
                               Placement="Top"
                               VerticalOffset="-7"
                               AllowsTransparency="True"
                               StaysOpen="False">
                            <Border Width="348"
                                    MaxHeight="262"
                                    Padding="5"
                                    Background="{DynamicResource ElevatedBrush}"
                                    BorderBrush="{DynamicResource StrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.36" Color="{StaticResource ColorShadow}" />
                                </Border.Effect>
                                <DockPanel>
                                    <TextBlock x:Name="SkillSuggestionStatus"
                                               DockPanel.Dock="Bottom"
                                               Margin="8,6,8,4"
                                               Text="选择后将插入标准 /skill: 技能调用"
                                               FontSize="{StaticResource TypographySizeCaption}"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                    <ListBox x:Name="SkillSuggestionList"
                                             MaxHeight="206"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="8,7" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="{StaticResource TypographySizeBodySmall}"
                                                                   FontWeight="{StaticResource TypographyWeightSemibold}" />
                                                        <TextBlock Text="{Binding Description}"
                                                                   Margin="0,2,0,0"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   FontSize="{StaticResource TypographySizeCaption}"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding KindLabel}"
                                                               Margin="10,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="{StaticResource TypographySizeCaption}"
                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                        </Popup>
                    </Grid>
                    <Button Grid.Column="2" x:Name="DirectionButton" Content="发送新一轮" Focusable="False"
                            VerticalAlignment="Center"
                            Padding="12,8" Click="OnDirectionClick" />
                </Grid>

                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Button x:Name="OpenCurrentTaskButton" Content="打开当前任务 ↗" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Right"
                            Focusable="False" Click="OnOpenChatClick" />
                </Grid>
            </Grid>
        </Grid>
        </Border>

        <Popup x:Name="TaskPickerPopup"
           AllowsTransparency="True"
           StaysOpen="True"
           Placement="Custom"
           PopupAnimation="Fade"
           Opened="OnTaskPickerOpened"
           Closed="OnTaskPickerClosed">
        <Border Width="310"
                Padding="4,6"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="1"
                CornerRadius="12"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.44" Color="{StaticResource ColorShadow}" />
            </Border.Effect>
            <ListBox x:Name="TaskPickerList"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     SelectionChanged="OnTaskPickerSelectionChanged"
                     PreviewMouseLeftButtonDown="OnTaskPickerItemClick"
                     PreviewMouseWheel="OnTaskPickerMouseWheel"
                     PreviewKeyDown="OnTaskPickerKeyDown"
                     KeyboardNavigation.DirectionalNavigation="Contained">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Height" Value="54" />
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="PickerItemBorder"
                                            Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="PickerItemBorder" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="PickerItemBorder" Property="Background" Value="{DynamicResource RaisedBrush}" />
                                            <Setter TargetName="PickerItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter TargetName="PickerItemBorder" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}"
                                       FontSize="{StaticResource TypographySizeBody}"
                                       FontWeight="{StaticResource TypographyWeightSemibold}"
                                       TextTrimming="CharacterEllipsis" />
                            <Grid Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="TaskStatusDot"
                                         Width="7"
                                         Height="7"
                                         Margin="0,0,7,0"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Fill="{Binding StatusBrush}" />
                                <TextBlock x:Name="TaskStatus"
                                           Grid.Column="1"
                                           Text="{Binding Status}"
                                           FontSize="{StaticResource TypographySizeCaption}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2"
                                           Margin="10,0,0,0"
                                           MaxWidth="110"
                                           Text="{Binding Workspace}"
                                           HorizontalAlignment="Right"
                                           FontSize="{StaticResource TypographySizeCaption}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        </Popup>
    </Grid>
</Window>
